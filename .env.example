# EduForge 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# —— 大模型 API Key（至少配置一个）——
# OpenAI 兼容（含本地 vLLM / Ollama 暴露的 OpenAI 格式端点）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 阿里云百炼 / 通义千问
DASHSCOPE_API_KEY=sk-xxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx

# 本地模型（内网 / 离线部署，数据不出校）
# 例如校园内网 qwen3-vl-8b 暴露的 OpenAI 格式接口
LOCAL_MODEL_URL=http://localhost:8001/v1

# —— 服务端口 ——
PORT=8005

# —— 数据安全策略（见 README §数据合规）——
# off      完全关闭检查（不推荐，仅排查用）
# warn     只定级与记录，不改变行为 ← 默认
# sanitize 命中敏感级别时先本地脱敏（抹身份标识、保留教学语义）再发往云端
# enforce  命中 L3 及以上且目标在公网时直接阻断，并给出改用校内模型的提示
# 注意：配置缺失或写错时回退到 warn，而不是 off —— 配置错误就关掉防护是最危险的失败模式
EDUFORGE_SAFETY_MODE=warn
